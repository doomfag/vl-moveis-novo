# Copy to .env.local for local development; never commit secret values.
# Absolute path recommended on a production persistent volume.
# DB_PATH=/path/to/persistent/store.sqlite
# Required behind a proxy in production; set the exact public HTTPS origin.
# APP_ORIGIN=https://www.sua-loja.com.br
# Optional connector for an external inventory system. Generate securely and
# configure it in server environment settings, never in chat or public code.
# INVENTORY_WEBHOOK_SECRET=

# Real email delivery via Resend. Use a sender on a verified domain.
# Store the API key only in server environment settings or .env.local.
# RESEND_API_KEY=
# EMAIL_FROM=VL Móveis <contato@seu-dominio.com.br>
# EMAIL_MODE=local is only for localhost tests; messages are NOT delivered.
# EMAIL_PREVIEW_DIR=data/emails-local

# Optional initial store owner. Only this verified email can receive the initial
# admin role; never put this setting in NEXT_PUBLIC_* or a browser form.
# STORE_OWNER_EMAIL=
# Persistent uploaded photos for self-hosting (same volume as DB_PATH).
# CATALOG_UPLOAD_DIR=/var/lib/vl-moveis/photos

# Optional owner notifications. Defaults to STORE_OWNER_EMAIL, never public.
# CHAT_NOTIFY_EMAIL=
